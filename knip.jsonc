{
  "$schema": "https://unpkg.com/knip@5/schema-jsonc.json",

  "entry": ["src/main/index.ts", "src/renderer/index.tsx"],
  "project": ["*.{js,mjs,ts}", "src/**/*.{ts,tsx}"],

  "ignoreBinaries": ["yq"],
  "ignoreDependencies": [
    // Build-only plugins; Knip does not execute the Electron Vite config.
    "@vitejs/plugin-react",
    "vite-plugin-sass-dts",
    // optional peer of node-fetch (via @kubernetes/client-node), resolved & bundled at build time
    "encoding",
    // vitest environment selected via the `// @vitest-environment jsdom` pragma in hook tests
    "jsdom"
  ],

  "typescript": {
    "config": ["tsconfig.json"]
  },
  // The electron-vite plugin (Knip 6.35+) executes electron.vite.config.ts and trips on the
  // ESM-only @vitejs/plugin-react; the build-only plugins stay in ignoreDependencies instead.
  "electron-vite": false,
  "exclude": ["exports"]
}
